{
  "$schema": "https://biomejs.dev/schemas/2.2.3/schema.json",
  "extends": ["ultracite"],
  "files": {
    "ignoreUnknown": true,
    "includes": ["src/**/*.{ts,tsx,js,jsx}", "!src/routeTree.gen.ts"]
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "style": {
        "noHeadElement": "off",
        "useFilenamingConvention": "off",
        "noMagicNumbers": "off"
      },
      "correctness": {
        "noUnknownProperty": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noUnknownAtRules": "off"
      }
    }
  }
}
